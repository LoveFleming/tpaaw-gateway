{
  "version": 1,
  "dispatchStrategy": "balanced",
  "autoExecute": {
    "tests": true,
    "docs": true,
    "refactor": false,
    "securityFix": false,
    "breakingChange": false
  },
  "taskDecomposition": {
    "maxSubtasks": 10,
    "defaultEffort": "S",
    "requireEstimate": true
  },
  "reporting": {
    "format": "summary",
    "includeCodeChanges": true,
    "includeActionLog": true
  },
  "model": {
    "planning": "openrouter/deepseek/deepseek-v4.1-flash",
    "dispatch": "openrouter/deepseek/deepseek-v4.1-flash"
  },
  "closedLoop": {
    "enabled": true,
    "maxRounds": 30
  },
  "dispatchableAgents": [],
  "blockedAgents": [],
  "reviewConfig": {
    "multiAgentReview": true,
    "reviewModels": [
      "zai/glm-5.1",
      "zai/glm-5"
    ],
    "autoRework": true
  },
  "planningScope": {
    "gitChanges": true,
    "openIssues": true,
    "openTasks": true,
    "securityFindings": true,
    "testCoverage": true,
    "codeIntelligence": false
  }
}