        "a5ae75d refactor(gateway): split gateway.mjs core into src/lib/{config,install,process}.mjs",
        "128fbdf refactor(server): split src/server.mjs into thin entry + 5 modules",
        "b8aedeb chore: .paaw/agents coding.* override 清除 — module registry 接管（2026-10-09 firmware 化）",
